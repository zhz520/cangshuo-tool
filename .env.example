COMPOSE_PROJECT_NAME=cangshuo-toolbox-local
WEB_DOMAIN=tool.zhzgo.cn
API_DOMAIN=toolapi.zhzgo.cn
CORS_ALLOWED_ORIGINS=https://tool.zhzgo.cn

LOCAL_WEB_PORT=8088
LOCAL_API_PORT=8081
LOCAL_MYSQL_PORT=3307
LOCAL_REDIS_PORT=6380
LOCAL_MINIO_PORT=9000
LOCAL_MINIO_CONSOLE_PORT=9001

MYSQL_DATABASE=toolbox
MYSQL_USER=toolbox
DB_SSL_MODE=REQUIRED
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false
MINIO_ROOT_USER=toolbox_dev
MINIO_ROOT_PASSWORD=
JWT_SECRET=
STORAGE_ENABLED=false
MINIO_BUCKET=toolbox-files
MINIO_PRESIGNED_EXPIRY_SECONDS=900
MINIO_MAX_OBJECT_BYTES=26214400
MINIO_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/webp,application/pdf,text/plain
STORAGE_QUOTA_ENABLED=true
STORAGE_MAX_OWNER_BYTES=104857600
STORAGE_MAX_OWNER_OBJECTS=200
STORAGE_MAX_TOTAL_BYTES=1073741824
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ANONYMOUS=600
RATE_LIMIT_MAX_AUTHENTICATED=3000
RATE_LIMIT_MAX_AUTH_ATTEMPTS=30
ADMIN_TOKEN_TTL_SECONDS=3600
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
AI_ENABLED=false
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_TOKEN_PARAMETER=max_completion_tokens
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_SECONDS=30
AI_DAILY_ATTEMPTS=20
AI_MAX_CONCURRENT=4
AI_PROVIDER_NAME=AI provider
ZEPP_ENABLED=true
# Web media parser (short-video tool). MEDIA_XHS_COOKIE is optional and only sent to Xiaohongshu hosts.
MEDIA_ENABLED=true
LANZOU_ENABLED=true
LANZOU_LINK_SECRET=replace-with-at-least-32-random-characters
MEDIA_XHS_COOKIE=
MEDIA_BROWSER_URL=
# Keep true on hosts with unprivileged user namespaces; legacy kernels may require false in the isolated browser container.
MEDIA_BROWSER_SANDBOX=true
# Optional private Chromium sidecar: add deploy/docker-compose.media.yml to the compose command.
# With that overlay the default endpoint is http://media-browser:8080; no host port is published.
# Zepp Life login protocol AES material, supplied on the server only (16 UTF-8 bytes each).
ZEPP_LOGIN_KEY=
ZEPP_LOGIN_IV=
